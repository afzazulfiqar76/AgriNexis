# Expo Metro + web dev server (required for port 8002)
PORT=8002

# Django API (backend): http://localhost:8000

# Local simulators / Expo web
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Physical device on same Wi-Fi — use your PC LAN IP instead of localhost:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

# Android emulator: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

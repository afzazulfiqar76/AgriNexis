DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set USE_SQLITE=True for local dev when MySQL is not installed
USE_SQLITE=False

DB_NAME=agrinexis
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Local ports: API 8003 | Web client 8001 | Expo mobile 8002
# (FYP project uses API :8000 and Vite :5173 — run both side by side)
# Allow any origin (recommended for local dev)
CORS_ALLOW_ALL_ORIGINS=True
# When CORS_ALLOW_ALL_ORIGINS=False, comma-separated allowlist only:
# CORS_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:8002,http://127.0.0.1:8002

ADMIN_EMAIL=S2023065070@umt.edu.pk
ADMIN_PASSWORD=S2023065070
ADMIN_FULL_NAME=System Administrator

# AgriNexis Assistant (chatbot) — local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini
SUPPORT_EMAIL=support@agrinexis.com

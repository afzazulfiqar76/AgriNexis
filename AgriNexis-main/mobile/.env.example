# Expo Metro MUST stay on 8002 (Django API is 8003 — never let Expo steal it)
PORT=8002
RCT_METRO_PORT=8002

# Django API (backend): http://localhost:8003

# Local simulators / Expo web
EXPO_PUBLIC_API_BASE_URL=http://localhost:8003

# Physical device on same Wi-Fi — use your PC LAN IP instead of localhost:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8003

# Android emulator: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8003
